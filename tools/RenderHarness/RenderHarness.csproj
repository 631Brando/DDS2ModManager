<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the real MainWindow and GameSelectorWindow XAML to PNGs, offscreen, against this PC's
    actual game library - for checking UI changes without driving the app. Not part of
    DDS2ModManager.sln on purpose: CI and the release workflow never build it. How to run it is
    at the top of Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The app is a self-contained exe; the harness only needs its types. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DDS2ModManager.csproj" />
  </ItemGroup>

</Project>
