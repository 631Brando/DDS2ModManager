<Window x:Class="DDS2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="DDS2 Mod Manager" Height="780" Width="1200" MinWidth="980" MinHeight="600"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:ModTypeToBrushConverter x:Key="ModTypeToBrush"/>
        <conv:BoolToEnabledTextConverter x:Key="BoolToEnabledText"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- mods + conflicts -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
            <RowDefinition Height="Auto"/>   <!-- log panel -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="DDS2 Mod Manager" FontSize="24" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Game folder:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding GamePathDisplay}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Browse..." Style="{StaticResource GhostButton}" Command="{Binding BrowseGameFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="⚙ Settings" Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Toolbar ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Install Mod..." Style="{StaticResource AccentButton}" Command="{Binding InstallModCommand}" Margin="0,0,8,0"/>
                <Button Content="Check Compatibility" Style="{StaticResource GhostButton}" Command="{Binding RunCompatibilityCheckCommand}" Margin="0,0,8,0"/>
                <Button Content="Deep Scan" Style="{StaticResource GhostButton}" Command="{Binding RunDeepScanCommand}" Margin="0,0,8,0"
                        ToolTip="Re-reads installed pak files in place for the most accurate conflict detection."/>
                <Button Content="Create LogicMods Folder" Style="{StaticResource GhostButton}" Command="{Binding CreateLogicModsFolderCommand}"/>
            </StackPanel>

            <!-- UE4SS status card -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True"/>
                                            <Condition Binding="{Binding Ue4ssStatus.IsManagedByUs}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="UE4SS not installed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True">
                                            <Setter Property="Text" Value="UE4SS installed (unverified experimental)"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True"/>
                                                <Condition Binding="{Binding Ue4ssStatus.IsManagedByUs}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="UE4SS experimental - up to date"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Ue4ssStatus.InstalledAssetName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Content="Update" Style="{StaticResource SmallActionButton}" Margin="12,0,0,0"
                            Command="{Binding InstallOrUpdateUE4SSCommand}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Install" Style="{StaticResource AccentButton}" Padding="10,4" FontSize="12" Margin="12,0,0,0"
                            Command="{Binding InstallOrUpdateUE4SSCommand}"
                            Visibility="{Binding Ue4ssStatus.IsInstalled, Converter={StaticResource InverseBoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Mods + Conflicts ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Mod list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid ItemsSource="{Binding Mods}" BorderThickness="0" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>

                        <DataGridTemplateColumn Header="Type" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Type, Converter={StaticResource ModTypeToBrush}}"
                                            CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Opacity="0.85">
                                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" Foreground="#12131A"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Status" Binding="{Binding IsEnabled, Converter={StaticResource BoolToEnabledText}}" Width="90"/>

                        <DataGridTemplateColumn Header="Actions" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Files" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding DataContext.ViewFilesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Disable" Style="{StaticResource SmallActionButton}"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.DisableModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Enable" Style="{StaticResource SmallActionButton}"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}"
                                                Command="{Binding DataContext.EnableModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Uninstall" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding DataContext.UninstallModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Conflicts panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Compatibility" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Top" Text="No conflicts detected." Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding Conflicts.Count, Converter={StaticResource ZeroCountToVisibility}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#241A2E" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AssetPath}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12">
                                                <Run Text="Conflict between: "/>
                                                <Run Text="{Binding ConflictingModNames}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource WarningBrush}">
                                                <Run Text="Likely wins (last loaded): "/>
                                                <Run Text="{Binding LikelyWinningModName}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar Width="160" Height="6" Margin="12,0,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}" Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save Log" Style="{StaticResource SmallActionButton}" Command="{Binding SaveLogCommand}"/>
                <Button Content="Toggle Log" Style="{StaticResource SmallActionButton}" Command="{Binding ToggleLogCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Log panel ===== -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Height="170"
                Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="LogScroller">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
