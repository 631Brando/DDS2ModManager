<Window x:Class="DDS2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="{Binding WindowTitle}" Height="980" Width="1760" MinWidth="980" MinHeight="600"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <!-- Keyboard shortcuts for the things people do repeatedly. Deliberately none for the
         destructive actions: uninstalling and resetting stay behind a deliberate click, because a
         key pressed with the grid focused and the wrong row selected is exactly the kind of
         mistake a shortcut should not make easy. Each gesture is repeated in its button's tooltip,
         since a shortcut nobody can discover is the same as no shortcut. -->
    <Window.InputBindings>
        <!-- Ctrl+F is added in code-behind: it moves focus to a named control, which is the view's
             own business and nothing the view model should know about. -->
        <KeyBinding Key="Escape"                Command="{Binding ClearModSearchCommand}"/>
        <KeyBinding Key="O"   Modifiers="Ctrl" Command="{Binding InstallModCommand}"/>
        <KeyBinding Key="F5"                    Command="{Binding RunDeepScanCommand}"/>
        <KeyBinding Key="U"   Modifiers="Ctrl" Command="{Binding CheckModUpdatesCommand}"/>
        <KeyBinding Key="L"   Modifiers="Ctrl" Command="{Binding ToggleLogCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="S"   Modifiers="Ctrl" Command="{Binding OpenGameDataCommand}"/>
        <KeyBinding Key="P"   Modifiers="Ctrl" Command="{Binding OpenProfilesCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:ModTypeToBrushConverter x:Key="ModTypeToBrush"/>
        <conv:BoolToEnabledTextConverter x:Key="BoolToEnabledText"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:ConflictSeverityToBrushConverter x:Key="SeverityToBrush"/>
        <conv:ConflictSeverityToLabelConverter x:Key="SeverityToLabel"/>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility"/>

        <!-- A checkbox that reads as a star rather than a tick box. Unstarred is a dim outline
             rather than nothing, so the column doesn't look empty and unclickable. -->
        <Style x:Key="StarCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <TextBlock x:Name="Glyph" Text="☆" FontSize="15" Padding="0,0,0,1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="★"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Nexus hover card =====
             Shown when a mod could be matched to its page on Nexus. Roughly half of a typical
             install is unpublished local work, so NO card is the normal case and the row simply
             behaves as it always did.

             The picture is fetched when the card is about to open (Row_ToolTipOpening) and stored
             on the mod itself, so the card appears immediately without one and gains it a moment
             later rather than freezing the window for the length of an HTTP request. -->
        <DataTemplate x:Key="NexusModCard">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0" MaxWidth="380">
                <StackPanel>
                    <!-- Collapses itself when there is no picture, so a card with only text has
                         no empty band at the top. -->
                    <Border CornerRadius="8,8,0,0" ClipToBounds="True" MaxHeight="180"
                            Visibility="{Binding NexusInfo.CardImageUrl, Converter={StaticResource NonEmptyToVisibility}}">
                        <Image Source="{Binding NexusThumbnail}" Stretch="UniformToFill" MaxHeight="180"/>
                    </Border>

                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding NexusInfo.Name}" FontWeight="SemiBold" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding NexusInfo.Uploader, StringFormat='by {0}'}"
                                   Visibility="{Binding NexusInfo.Uploader, Converter={StaticResource NonEmptyToVisibility}}"/>

                        <TextBlock Text="{Binding NexusInfo.Summary}" Margin="0,8,0,0" FontSize="12"
                                   TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Visibility="{Binding NexusInfo.Summary, Converter={StaticResource NonEmptyToVisibility}}"/>

                        <!-- Nexus's own version, which is the AUTHOR'S published number. It is
                             deliberately not compared against the installed version: updates come
                             from the mod's own repository, never from here, and implying otherwise
                             would be the one misleading thing this card could do. -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding NexusInfo.Version, StringFormat='Nexus version {0}'}"
                                       Visibility="{Binding NexusInfo.Version, Converter={StaticResource NonEmptyToVisibility}}"/>
                            <TextBlock FontSize="11" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding NexusInfo.Downloads, StringFormat='{}{0:N0} downloads'}"/>
                            <TextBlock FontSize="11" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding NexusInfo.Endorsements, StringFormat='{}{0:N0} endorsements'}"/>
                        </StackPanel>

                        <!-- Bound directly to the ModInfo: a tooltip lives in its own PopupRoot,
                             so a RelativeSource AncestorType=Window binding here silently blanks. -->
                        <TextBlock Text="Click the row's Nexus link to open this page."
                                   FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasExplicitNexusLink, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <TextBlock Text="You linked this mod to this page yourself. Use the row's &quot;link&quot; button to change it."
                                   FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasExplicitNexusLink, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- x:Shared="False" is load-bearing, not decoration.
             A ToolTip written inline in a Setter.Value is created ONCE and handed to every row
             that uses the style, so all 19 rows would fight over one instance - and whichever row
             opened it last would own it. This hands out a fresh one per row instead.

             Content="{Binding}" resolves because WPF sets a tooltip's DataContext from whatever
             it is placed on, which for a row style is the ModInfo. -->
        <ToolTip x:Key="NexusModToolTip" x:Shared="False"
                 Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True"
                 Content="{Binding}" ContentTemplate="{StaticResource NexusModCard}"/>

        <!-- Applied to every row. A mod with no Nexus match gets no tooltip at all rather than an
             empty one, which is what the HasNexusInfo trigger is for. The trigger re-evaluates
             when NexusInfo arrives, since matching happens asynchronously after startup. -->
        <Style x:Key="ModRowStyle" TargetType="DataGridRow">
            <!-- Fetches the card's picture just before it appears, so nothing is downloaded for
                 mods the user never hovers over. -->
            <EventSetter Event="ToolTipOpening" Handler="Row_ToolTipOpening"/>
            <Style.Triggers>
                <!-- HasNexusInfo, deliberately NOT HasNexusPage. The card shows a picture, a title
                     and a description, and a link alone carries none of those - a mod linked to a
                     page not yet in the cached catalogue gets a working button and no card, rather
                     than a card asserting it has zero downloads. -->
                <DataTrigger Binding="{Binding HasNexusInfo}" Value="True">
                    <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                    <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                    <!-- Rows are wide and mostly empty space; without this the card only appears
                         over the text itself, which reads as it not working. -->
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="ToolTip" Value="{StaticResource NexusModToolTip}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- game tabs -->
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- mods + conflicts -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
            <RowDefinition Height="Auto"/>   <!-- log panel -->
        </Grid.RowDefinitions>

        <!-- ===== Game tabs =====
             At the very top and always visible, both games always present. A strip that appeared
             only when a second game happened to be installed would be invisible to most users,
             which defeats the point: this exists so it is never ambiguous which game is being
             modded. A game that isn't installed keeps its tab and turns into a "find it" button,
             because "we don't support that" and "we can't see it" look identical otherwise. -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding GameTabs}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SwitchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Margin="0,0,8,0" Padding="0" BorderThickness="0" Cursor="Hand"
                            HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Tab" CornerRadius="8,8,0,0" Padding="16,9"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1,1,1,0">
                                    <StackPanel>
                                        <TextBlock x:Name="Short" Text="{Binding ShortName}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="10" Margin="0,1,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- EVERY visual state lives here, in ControlTemplate.Triggers,
                                     targeting the named Border.

                                     It cannot live in a <Border.Style> on that same Border. The
                                     Background / BorderBrush / BorderThickness above are written as
                                     ATTRIBUTES in this template's markup, which WPF ranks as
                                     BaseValueSource.ParentTemplate - above BaseValueSource.StyleTrigger.
                                     A Style trigger trying to change them is silently discarded, so
                                     the active tab rendered pixel-identical to an inactive one and
                                     clicking a tab looked like it did nothing at all, even though the
                                     game underneath had switched. A trigger declared HERE resolves as
                                     ParentTemplateTrigger and does win. -->
                                <ControlTemplate.Triggers>
                                    <!-- A 3px accent lid rather than a colour swap, so the active tab
                                         reads at a glance even out of the corner of the eye. -->
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Tab" Property="Background"
                                                Value="{StaticResource BgBrush}"/>
                                        <Setter TargetName="Tab" Property="BorderBrush"
                                                Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Tab" Property="BorderThickness"
                                                Value="1,3,1,0"/>
                                        <Setter TargetName="Short" Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}"/>
                                    </DataTrigger>

                                    <!-- Dimmed, not hidden: the tab still works, it just opens a
                                         folder picker instead of switching. -->
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter TargetName="Tab" Property="Opacity" Value="0.55"/>
                                    </DataTrigger>

                                    <!-- Hover has to look DIFFERENT from active, not identical to it.
                                         Both used to brighten the label and nothing else, so the tab
                                         under the pointer was indistinguishable from the open one. -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tab" Property="BorderBrush"
                                                Value="{StaticResource AccentHoverBrush}"/>
                                        <Setter TargetName="Short" Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>

                                    <!-- The strip goes dead for the length of a switch: both tabs share
                                         one AsyncRelayCommand, whose CanExecute is false while it runs.
                                         Without this a click during those seconds produced nothing at
                                         all - no highlight, no message - which is indistinguishable
                                         from the app ignoring you. -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Tab" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- ===== Header ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="24" FontWeight="Bold"/>
                    <!-- On screen, not just buried in Settings. A bug report that names a
                         version is worth several that don't, and nobody goes looking for it. -->
                    <TextBlock Text="{Binding AppVersionDisplay}" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Bottom" Padding="0,0,0,4"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Game folder:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding GamePathDisplay}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Browse..." Style="{StaticResource GhostButton}" Command="{Binding BrowseGameFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="⚙ Settings" Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Toolbar ===== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- WrapPanel, not StackPanel. A horizontal StackPanel gives its children unlimited
                 width and simply clips whatever runs past the edge, which is how the last button
                 disappeared under the UE4SS card. This wraps to a second row instead, so adding a
                 button can never hide one again. -->
            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Six actions you reach for regularly. Everything rarer - and everything you only
                     want when something has gone wrong - is under "More". Thirteen buttons across
                     two rows didn't make the rare ones easy to reach, it made the common ones hard
                     to find. -->
                <Button Content="Install Mod..." Style="{StaticResource AccentButton}" Command="{Binding InstallModCommand}" Margin="0,0,8,6"
                        ToolTip="Install a mod from a .zip, .7z, .rar or folder. You can also drag one onto this window.  (Ctrl+O)"/>
                <Button Content="▶ Play" Style="{StaticResource PlayButton}" Command="{Binding LaunchGameCommand}"
                        Margin="0,0,8,6"
                        ToolTip="Launches the game through Steam. Warns first if your enabled mods have critical conflicts."/>
                <Button Content="Check Mod Updates" Style="{StaticResource GhostButton}" Command="{Binding CheckModUpdatesCommand}" Margin="0,0,8,6"
                        ToolTip="Checks each mod that publishes an update address for a newer release. Those updates come from the mod author's own repository, not from Nexus, and nothing is downloaded or installed without asking.  (Ctrl+U)"/>
                <Button Content="Re-scan Mod Files" Style="{StaticResource GhostButton}" Command="{Binding RunDeepScanCommand}" Margin="0,0,8,6"
                        ToolTip="Re-reads every installed mod's pak from disk. Conflict checking is automatic, so you only need this if a mod's files changed outside the manager.  (F5)"/>
                <Button Content="Saves &amp; Config" Style="{StaticResource GhostButton}" Command="{Binding OpenGameDataCommand}"
                        Margin="0,0,8,6"
                        ToolTip="View, clone, disable or delete save games, and edit the game's config files.  (Ctrl+S)"/>
                <Button Content="Profiles" Style="{StaticResource GhostButton}" Command="{Binding OpenProfilesCommand}"
                        Margin="0,0,8,6"
                        ToolTip="Saved sets of enabled mods. Applying one only toggles mods you already have.  (Ctrl+P)"/>

                <!-- A Popup rather than a ContextMenu: menus aren't styled for this dark theme, so
                     one would render as WPF's default light chrome - the same white-on-white the
                     tooltips used to have. This reuses the button styles that are known good. -->
                <Button x:Name="MoreButton" Content="More  ▾" Style="{StaticResource GhostButton}" Margin="0,0,8,6"
                        Click="MoreMenu_Click"
                        ToolTip="Less common actions, and the tools for when something has gone wrong."/>
                <Popup x:Name="MoreMenu" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom"
                       VerticalOffset="2" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6">
                        <StackPanel MinWidth="215">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </StackPanel.Resources>

                            <Button Content="Trusted Mods" Command="{Binding BrowseTrustedModsCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="DDS2 mods from authors the maintainers rate, listed from Nexus with pictures and descriptions."/>
                            <Button Content="Find Existing Mods" Command="{Binding ScanForExistingModsCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="Finds mods already in your game folders that this manager isn't tracking yet, and offers to import them."/>
                            <Button Content="History" Command="{Binding OpenHistoryCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="What changed and when, including the release notes from each update you applied."/>
                            <Button Content="Find File" Command="{Binding FindAssetOwnersCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="Which mods contain a given file or asset path? Useful when one specific thing is broken and you want to know what is touching it."/>
                            <Button Content="Diagnostics" Command="{Binding ExportDiagnosticsCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="Saves one zip with your logs, mod list, conflicts and versions - everything a bug report needs. No saves or config files are included."/>

                            <Separator Margin="4,4,4,5" Background="{StaticResource CardBorderBrush}"/>

                            <Button Content="Mod Authors" Command="{Binding OpenModAuthorGuideCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="Making a mod? How to add an update address so this manager can tell players when you publish a new version."/>
                            <Button Content="Credits" Command="{Binding OpenCreditsCommand}" Click="MoreMenuItem_Click"
                                    ToolTip="Who made this, and the projects it's built on."/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Conditional, so they sit beside the primary actions only while they apply. -->
                <Button Content="Update All" Style="{StaticResource AccentButton}" Command="{Binding UpdateAllModsCommand}"
                        Margin="0,0,8,6"
                        Visibility="{Binding HasUpdatesToApply, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Applies every waiting mod update. You're still asked about each one - they come from different authors' repositories."/>

                <!-- One step only, and only for actions that can be honestly reversed. -->
                <Button Style="{StaticResource GhostButton}" Command="{Binding UndoLastCommand}"
                        Content="↶ Undo" Margin="0,0,8,6"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{Binding UndoDescription, StringFormat='Undo: {0}'}"/>

                <!-- Searches name, type, author, version, and the mod's Nexus title and
                     description. Not the contained asset paths - a mod has hundreds, so that
                     would make almost anything match almost everything. -->
                <Border Background="#20222E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Margin="16,0,0,0" MinWidth="200" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="ModSearchBox"
                                 Text="{Binding ModSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 Padding="8,0" Foreground="{StaticResource TextPrimaryBrush}"
                                 ToolTip="Filter the mod list. Searches names, type, author, and Nexus descriptions.  (Ctrl+F)"/>

                        <!-- Placeholder text, shown only while the box is empty. A TextBox has no
                             built-in one, and IsHitTestVisible=False keeps it from stealing the
                             click that focuses the box. -->
                        <TextBlock Grid.Column="0" Text="Search mods..." Margin="9,0,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IsModSearchActive, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <Button Grid.Column="1" Content="✕" Style="{StaticResource LinkButton}" Padding="8,0"
                                Command="{Binding ClearModSearchCommand}" ToolTip="Clear the search"
                                Visibility="{Binding IsModSearchActive, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ModSearchSummary}" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding IsModSearchActive, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Appears only once more than one row is selected. With a single row selected
                     the row's own buttons already do everything these would. -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,6"/>
                    <Button Content="Enable" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                            Command="{Binding BulkEnableCommand}" Margin="0,0,6,0"/>
                    <Button Content="Disable" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                            Command="{Binding BulkDisableCommand}" Margin="0,0,6,0"/>
                    <Button Content="Uninstall" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                            Foreground="{StaticResource ErrorBrush}" Command="{Binding BulkUninstallCommand}"
                            ToolTip="Removes the selected mods' files from the game. Asks first."/>
                </StackPanel>
            </WrapPanel>

            <!-- UE4SS status card -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True"/>
                                            <Condition Binding="{Binding Ue4ssStatus.IsManagedByUs}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel>
                        <!-- Text comes from Ue4ssStatus.StatusLabel, because the honest wording depends
                             on which GAME is open and not just on two booleans - "unverified
                             experimental" names the build that crashes DDS1 on startup. Only the
                             update-available case stays here, since it depends on UpdateAvailable,
                             a view-model property the status object cannot see. -->
                        <TextBlock FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Ue4ssStatus.StatusLabel}"/>
                                    <Style.Triggers>
                                        <!-- Must come after the "up to date" trigger above so it wins when both match
                                             (WPF resolves same-property Setters from multiple matching triggers by
                                             declaration order, last wins) - "up to date" only ever meant "installed
                                             and verified as the experimental build," never "matches the latest
                                             GitHub release," so without this the label kept claiming up to date
                                             even while the Update button (driven by UpdateAvailable, a real asset-
                                             name comparison) was showing because a newer build genuinely existed. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Ue4ssStatus.IsInstalled}" Value="True"/>
                                                <Condition Binding="{Binding Ue4ssStatus.IsManagedByUs}" Value="True"/>
                                                <Condition Binding="{Binding UpdateAvailable}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="UE4SS experimental - update available"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Ue4ssStatus.InstalledAssetName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Content="Update" Style="{StaticResource SmallActionButton}" Margin="12,0,0,0"
                            Command="{Binding InstallOrUpdateUE4SSCommand}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Only once an update has actually replaced something. The release channel is a
                         single rolling tag whose assets are replaced in place, so the build someone
                         was on cannot be downloaded again - this copy is the only way back. -->
                    <Button Content="Undo update" Style="{StaticResource SmallActionButton}" Margin="8,0,0,0"
                            Command="{Binding RestorePreviousUE4SSCommand}"
                            Visibility="{Binding CanRestoreUE4SS, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding PreviousUE4SS.Display, StringFormat='Go back to {0}'}"/>
                    <!-- Shown only when UE4SS is absent AND this game is one we may install it into.
                         Some games need a build that isn't published as a download, and installing the
                         one we can fetch would crash them - so the button is removed, not just likely
                         to fail, and the reason is written into the log instead. -->
                    <Button Content="Install" Padding="10,4" FontSize="12" Margin="12,0,0,0"
                            Command="{Binding InstallOrUpdateUE4SSCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Ue4ssStatus.IsInstalled}" Value="False"/>
                                            <Condition Binding="{Binding Ue4ssStatus.CanInstall}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Mods + Conflicts ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- The compatibility panel is usually a single line ("No conflicts found"), while
                     the mod grid has ten columns competing for room, so the split favours the grid. -->
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*" MinWidth="240"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- mod update banner -->
                <RowDefinition Height="Auto"/>   <!-- nexus new-mods banner -->
                <RowDefinition Height="*"/>      <!-- lists -->
            </Grid.RowDefinitions>

            <!-- Collapses to nothing when there are no updates, so it costs no space in the
                 normal case. Says where updates come from, because they are not from Nexus. -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}"
                    Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding HasModUpdates, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0"
                             Fill="{StaticResource AccentBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModUpdateBannerText}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Updates come from each mod author's own repository, not from Nexus."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Check again" Style="{StaticResource SmallActionButton}"
                            VerticalAlignment="Center"
                            Command="{Binding CheckModUpdatesCommand}"/>
                </Grid>
            </Border>

            <!--
                What's newly published on Nexus for this game. Discovery only - it links out,
                downloads nothing, and needs no Nexus account. Collapses entirely when there is
                nothing new, and dismissing it marks everything shown as seen.
            -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}"
                    Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding HasNexusNewMods, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Row="0" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                             Margin="0,0,9,0" Fill="#F5A524"/>

                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NexusBannerText}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Published since you last looked. Opens the mod page - nothing is downloaded."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="See all on Nexus" Style="{StaticResource SmallActionButton}"
                                Command="{Binding OpenNexusGameCommand}"/>
                        <Button Content="Dismiss" Style="{StaticResource SmallActionButton}"
                                Command="{Binding DismissNexusFeedCommand}"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding NexusNewMods}" Margin="18,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallActionButton}" Margin="0,0,8,6"
                                        Command="{Binding DataContext.OpenNexusModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Summary}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                        <TextBlock Text="{Binding AgeDisplay, StringFormat=' · {0}'}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Mod list -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
              <Grid>
                <!-- Shown only when nothing is installed at all, which is deliberately NOT the same
                     as "no rows visible". A search that matches nothing leaves Mods.Count above
                     zero, and that case already has its own answer next to the search box - so
                     binding to the underlying list rather than the filtered view keeps the two from
                     ever appearing at once and contradicting each other. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                            MaxWidth="460" Panel.ZIndex="1"
                            Visibility="{Binding Mods.Count, Converter={StaticResource ZeroCountToVisibility}}">
                    <TextBlock Text="No mods installed yet" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Drag a .zip, .7z or .rar onto this window, or use Install Mod… above. Every mod is opened and read before it's installed, so it lands in the right folder and you're told about conflicts up front."/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,10,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Already installed some by hand? More → Find Existing Mods will read them and offer to start tracking them, leaving the files where they are."/>
                </StackPanel>

                <!-- Scroll rather than squeeze. Every column below except Name has a fixed width,
                     so when they don't all fit something has to give - and without this, the thing
                     that gave was Name: the one column that says which mod a row actually is. -->
                <DataGrid ItemsSource="{Binding ModsView}" BorderThickness="0" Margin="0"
                          RowStyle="{StaticResource ModRowStyle}"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="ModGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <!-- Starred mods sort to the top by default. The header still sorts, so
                             clicking it groups favourites together the other way round. -->
                        <DataGridTemplateColumn Header="★" Width="34" SortMemberPath="IsFavourite">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsFavourite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Style="{StaticResource StarCheckBox}"
                                              ToolTip="Star this mod so it sorts to the top."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MinWidth is the point of this column. Name is the only flexible one, so
                             it absorbs the entire shortfall whenever the fixed columns don't fit -
                             which had collapsed it to zero, leaving every row with no visible mod
                             name at all. A floor turns that into a horizontal scrollbar instead,
                             and stops the next column anyone adds re-creating the same bug. -->
                        <DataGridTemplateColumn Header="Name" Width="*" MinWidth="220" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Marks one half of a mod that installs in two places, so
                                             it is obvious the two rows travel together before the
                                             user discovers it by toggling one. -->
                                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                Background="{StaticResource CardBorderBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsPartOfSet, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="This mod installs in more than one place. Enabling or disabling it applies to every part; uninstalling asks first.">
                                            <TextBlock Text="{Binding LinkedPartCount, StringFormat='🔗 {0} parts'}"
                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Template columns have no binding for the grid to sort on, so clicking
                             their header does nothing at all unless SortMemberPath says which
                             property to order by. Text columns get theirs from the binding. -->
                        <DataGridTemplateColumn Header="Type" Width="110" SortMemberPath="Type">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- VerticalAlignment matters: without it the border stretches to
                                         the full row height and the pill becomes a tall slab. -->
                                    <Border Background="{Binding Type, Converter={StaticResource ModTypeToBrush}}"
                                            CornerRadius="10" Padding="8,3" Opacity="0.85"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" Foreground="#12131A"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- OneWay because BoolToEnabledTextConverter has no ConvertBack; the grid
                             being read-only means it never fires today, but the default TwoWay
                             mode leaves that one edit away from throwing. -->
                        <DataGridTextColumn Header="Status" Width="76"
                                            Binding="{Binding IsEnabled, Mode=OneWay, Converter={StaticResource BoolToEnabledText}}"/>

                        <!-- Only ever populated for mods that publish a ModUpdateUrl. A blank
                             cell means "this mod doesn't offer updates", which is the normal
                             case and deliberately reads as nothing rather than as a problem.

                             Anything with a version also has somewhere that version came from,
                             so the source repo is one click away from it rather than buried in
                             a tooltip. SortMemberPath because a template column has nothing to
                             sort on otherwise. -->
                        <DataGridTemplateColumn Header="Version" Width="112" SortMemberPath="InstalledVersion">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstalledVersion}" VerticalAlignment="Center"/>
                                        <Button Content="source" Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding ModUpdateUrl, Converter={StaticResource NullToCollapsed}}"
                                                Command="{Binding DataContext.OpenModSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ModUpdateUrl}"/>

                                        <!-- The page this mod matched by name, or the one the user
                                             linked. HasNexusPage and NexusPageUrl, not the NexusInfo
                                             pair: a link to a mod published inside the three-day
                                             catalogue window has a page and no card yet. -->
                                        <Button Content="nexus" Style="{StaticResource LinkButton}"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasNexusPage, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenNexusPageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding NexusPageUrl}"/>

                                        <!-- The way in for a name matching can never reach - "AERR"
                                             is published as "AE Revolutions Reloaded". Hidden for a
                                             mod that matched cleanly (no reason to invite re-linking
                                             a working match) and shown for one already linked, so a
                                             mistyped id is one click from fixed rather than only
                                             reachable by hand-editing the registry. -->
                                        <Button Content="link" Style="{StaticResource LinkButton}"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding CanEditNexusLink, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.LinkNexusPageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Tell the manager which Nexus page this mod is, when its name doesn't match."/>

                                        <!-- Skips the six-hour cache, for an author who just
                                             published and wants to see it appear. -->
                                        <Button Content="↻" Style="{StaticResource LinkButton}"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasUpdateSource, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RecheckModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Check this mod for a new release right now, ignoring the six-hour cache."/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sorted by whether an update exists, not by the version string:
                             "everything with an update waiting" is the useful grouping, and
                             sorting free-text versions alphabetically puts 1.10 before 1.9. -->
                        <DataGridTemplateColumn Header="Update" Width="92" SortMemberPath="UpdateAvailable">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding LatestVersion, StringFormat='Get {0}'}"
                                            Style="{StaticResource SmallActionButton}"
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding ModUpdateUrl, StringFormat='Updates come from {0}'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Only shown for mods that actually publish updates - a trust tick on a
                             mod with no update channel would mean nothing. TwoWay so ticking it
                             writes straight through ModInfo.TrustedAuthor into ModTrustService.

                             Trust is granted per GitHub ACCOUNT rather than per mod, so ticking
                             this also lights up that author's other rows. The tooltip says so,
                             rather than letting it look like a bug. -->
                        <DataGridTemplateColumn Header="Trusted" Width="70" SortMemberPath="TrustedAuthor">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding TrustedAuthor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding ModUpdateUrl, Converter={StaticResource NullToCollapsed}}"
                                              IsEnabled="{Binding UpdateUrlChanged, Converter={StaticResource InverseBool}}"
                                              ToolTip="{Binding UpdateAuthor, StringFormat='Treat {0} as an update address you recognise. It applies to any mod naming that account, describes where updates are fetched from rather than who made this mod, and you are still asked before anything installs.'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- How much room the mod takes. Sorted numerically via SizeBytes rather
                             than on the formatted text, or "9 MB" would sort above "10 MB". -->
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="70"
                                            SortMemberPath="SizeBytes" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <!-- Files changed outside the manager. Not necessarily wrong -
                                         you may have edited them - but it explains behaviour that
                                         otherwise makes no sense. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDrifted}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="ToolTip"
                                                    Value="{Binding DriftSummary, StringFormat='Files changed outside the manager: {0}. Reinstall this mod to put it back to a known state.'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Your own labels, comma separated. Filtering is the search box: type a
                             tag and only mods carrying it remain, so there is no second filter to
                             learn. -->
                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags, UpdateSourceTrigger=LostFocus}"
                                            Width="100" SortMemberPath="Tags">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="ToolTip" Value="{Binding Tags}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTags}" Value="False">
                                            <Setter Property="Text" Value="tag..."/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="ToolTip" Value="Comma-separated labels, e.g. qol, tested. Search for one to filter by it."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Your own note about this mod. Editable in place - click the cell and
                             type. Saved the moment it changes, and never touched by an update or
                             a reinstall, because it belongs to you rather than to the mod. -->
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=LostFocus}"
                                            Width="110" SortMemberPath="Notes">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="{Binding Notes}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                            <Setter Property="Text" Value="Add a note..."/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="ToolTip" Value="Click to add your own note about this mod."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Nothing to order buttons by. -->
                        <DataGridTemplateColumn Header="Actions" Width="280" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Only appears once a check has actually found something,
                                             so an absent button means "nothing to install" rather
                                             than "this mod can't be updated". -->
                                        <Button Style="{StaticResource SmallActionButton}"
                                                Content="{Binding AvailableUpdateTag, StringFormat=Update to {0}}"
                                                Foreground="{StaticResource AccentBrush}"
                                                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Shows where the download comes from and asks before installing anything."/>
                                        <Button Content="Files" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding DataContext.ViewFilesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Disable" Style="{StaticResource SmallActionButton}"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.DisableModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Enable" Style="{StaticResource SmallActionButton}"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}"
                                                Command="{Binding DataContext.EnableModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Uninstall" Style="{StaticResource SmallActionButton}"
                                                Command="{Binding DataContext.UninstallModCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>

            <!-- Conflicts panel -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Compatibility" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>

                    <!-- The one line the user should be able to read and stop. Everything below is
                         supporting detail. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding CompatibilitySummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#241A2E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                        <StackPanel>
                                            <!-- Severity badge + who's involved. Both matter at a
                                                 glance: "these two mods" and "how bad is it". -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLabel}}"
                                                               FontSize="9" FontWeight="Bold" Foreground="#12131A"/>
                                                </Border>
                                                <TextBlock Text="{Binding ModNamesDisplay}" FontWeight="Bold" FontSize="13"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>

                                            <TextBlock Text="{Binding Explanation}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>

                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding ShowsWinner, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Likely wins (last loaded): "/>
                                                <Run Text="{Binding LikelyWinningModName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>

                                            <!-- Contested rows, grouped under the table they're in.
                                                 Only shown for real conflicts - these are the rows
                                                 the user has to actually make a decision about. -->
                                            <ItemsControl ItemsSource="{Binding OverlappingTables}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasOverlappingTables, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding TableName}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding RowsDisplay}" FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Harmlessly-shared tables collapse to one wrapped
                                                 line: seven of them used to be seven whole cards. -->
                                            <StackPanel Margin="0,5,0,0"
                                                        Visibility="{Binding HasCompatibleTables, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding CompatibleTablesHeader}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding CompatibleTablesDisplay}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,5,0,0"
                                                        Visibility="{Binding HasAssetPaths, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding AssetPathsHeader}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <ItemsControl ItemsSource="{Binding AssetPaths}" Margin="0,1,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                      </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar Width="160" Height="6" Margin="12,0,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}" Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save Log" Style="{StaticResource SmallActionButton}" Command="{Binding SaveLogCommand}"/>
                <Button Content="Toggle Log" Style="{StaticResource SmallActionButton}" Command="{Binding ToggleLogCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Log panel ===== -->
        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Height="170"
                Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="LogScroller">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
