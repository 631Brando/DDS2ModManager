<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DDS2ModManager</RootNamespace>
    <AssemblyName>DDS2ModManager</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Product>DDS2 Mod Manager</Product>
    <Version>1.0.4</Version>

    <!--
      True single-file publish. Without SelfContained + RuntimeIdentifier, `dotnet publish
      -p:PublishSingleFile=true` still leaves WPF's native interop DLLs (PresentationNative_cor3,
      wpfgfx_cor3, PenImc_cor3, D3DCompiler_47_cor3) and any native NuGet deps (blake3_dotnet.dll)
      sitting loose next to the exe - PublishSingleFile alone only bundles managed assemblies.
      IncludeNativeLibrariesForSelfExtract packs the native ones into the exe too; they get
      self-extracted to a per-app %TEMP% cache at first run, transparent to the user. This is a
      Windows-only WPF app, so hardcoding win-x64 here (rather than requiring -r on every publish
      call) is safe. None of this affects plain `dotnet build`/F5 - only `dotnet publish`.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Embed PDB info into the exe itself in Release so no loose .pdb ships alongside it. -->
    <DebugType Condition="'$(Configuration)'=='Release'">embedded</DebugType>
    <ApplicationIcon>902c6415f7ce3215f2d375ab22547552429bd92d.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="902c6415f7ce3215f2d375ab22547552429bd92d.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real NuGet package by FabianFG - parses .pak/.utoc/.ucas and .uasset content -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <!-- MVVM helpers: ObservableObject, [ObservableProperty], RelayCommand -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
    <!-- Archive extraction for .zip/.7z/.rar (System.IO.Compression only handles .zip) -->
    <PackageReference Include="SharpCompress" Version="0.50.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Replace Assets\mappings.usmap with your real mappings file before building.
      It gets embedded straight into the exe so end users never see or supply it.
    -->
    <EmbeddedResource Include="Assets\mappings.usmap" />
  </ItemGroup>

</Project>
