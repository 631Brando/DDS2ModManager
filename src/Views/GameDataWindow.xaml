<Window x:Class="DDS2ModManager.Views.GameDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="Saves &amp; Config" Height="680" Width="1020"
        MinHeight="520" MinWidth="1000" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:BoolToEnabledTextConverter x:Key="BoolToEnabledText"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="DarkTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource DarkTab}"/>
            </TabControl.Resources>

            <!-- ===== Saves ===== -->
            <TabItem Header="Saves">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- Shown only when Steam is demonstrably syncing this folder. The manager
                             edits saves on disk while Steam separately reconciles the same folder,
                             and that interaction is surprising enough to be worth saying out loud
                             rather than letting someone lose a save to it. -->
                        <Border x:Name="CloudBanner" Visibility="Collapsed" Margin="0,0,0,10"
                                Padding="12,9" CornerRadius="6" Background="#2A2418"
                                BorderThickness="1" BorderBrush="{StaticResource WarningBrush}">
                            <StackPanel>
                                <TextBlock x:Name="CloudHeadline" FontSize="12" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock x:Name="CloudDetail" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="CloudHow" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SavesPathText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <!-- Extended selection: shift/ctrl-click and Ctrl+A work as usual, so a
                             pile of old saves can be backed up or deleted in one go. -->
                        <DataGrid x:Name="SavesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" HeadersVisibility="Column" RowHeight="34"
                                  SelectionChanged="SavesGrid_SelectionChanged">
                            <!-- Mode=OneWay on every column: DataGridTextColumn binds TwoWay by
                                 default, and most of these are computed get-only properties. Even
                                 with IsReadOnly on the grid, leaving the default in place is the
                                 same footgun that previously threw "cannot work on the read-only
                                 property" once per row and looked like a hard crash. -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding GroupDisplay, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Contents" Binding="{Binding KindDisplay, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="85"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedDisplay, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Status" Width="80"
                                                    Binding="{Binding IsEnabled, Mode=OneWay, Converter={StaticResource BoolToEnabledText}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                        <TextBlock x:Name="SelectionSummary" DockPanel.Dock="Right" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <!-- One uniform width for the whole row. The toggle button's label
                                 changes with the selection, so without a shared minimum the row
                                 would shuffle sideways every time you clicked a different save. -->
                            <Style x:Key="SaveAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="MinWidth" Value="104"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <!-- Acts on the current selection, so these grey out when nothing is
                             selected rather than answering a click with "select a save first". -->
                        <Button x:Name="InspectButton" Content="Inspect..." Style="{StaticResource SaveAction}"
                                Click="InspectSave_Click"
                                ToolTip="Read-only view of what the game stored in this save."/>
                        <Button x:Name="CloneButton" Content="Clone..." Style="{StaticResource SaveAction}"
                                Click="CloneSave_Click"
                                ToolTip="Duplicates the selected save under a new name."/>
                        <Button x:Name="BackUpButton" Content="Back Up" Style="{StaticResource SaveAction}"
                                Click="BackupSave_Click"
                                ToolTip="Copies the selected saves to timestamped backups outside the game's save folder. Works on several at once."/>
                        <!-- Label is always a single word so it fits the shared width; which word
                             depends on the selection. See UpdateToggleEnabledButton. -->
                        <Button x:Name="ToggleEnabledButton" Content="Disable"
                                Style="{StaticResource SaveAction}" Click="ToggleEnabled_Click"
                                ToolTip="Disabling moves a save out of the game's save folder so it won't show in game; enabling moves it back. The label shows what will happen to the saves you've selected, and any already in that state are skipped."/>
                        <Button x:Name="DeleteButton" Content="Delete..." Style="{StaticResource SaveAction}"
                                Foreground="{StaticResource ErrorBrush}" Click="DeleteSave_Click"
                                ToolTip="Permanently deletes the selected saves. Ctrl+A selects everything."/>

                        <!-- Everything past here is general, not tied to the selection. -->
                        <Border Width="1" Margin="8,2,16,2" Background="{StaticResource CardBorderBrush}"/>

                        <Button Content="Saves Folder" Style="{StaticResource SaveAction}" Click="OpenSavesFolder_Click"
                                ToolTip="Opens the game's save folder in Explorer."/>
                        <Button Content="Backups" Style="{StaticResource SaveAction}" Click="OpenBackupsFolder_Click"
                                ToolTip="Opens the folder holding backups made with Back Up."/>
                        <Button Content="Refresh" Style="{StaticResource SaveAction}" Margin="0"
                                Click="RefreshSaves_Click"
                                ToolTip="Re-reads the save folder from disk."/>
                    </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== Config ===== -->
            <TabItem Header="Config Files">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Text="The original is backed up automatically the first time you save a file, so you can always put it back. Empty placeholder .ini files are hidden."/>

                    <!-- Grouped, because the two kinds are edited for different reasons and live in
                         different folders. A flat list would put UE4SS-settings.ini next to
                         Engine.ini and imply they do the same sort of thing. -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4">
                        <ListBox x:Name="ConfigList" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="ConfigList_SelectionChanged">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                       Margin="4,8,0,3" Foreground="{StaticResource TextMutedBrush}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Shown only for UE4SS's settings. The list already groups it, but the
                             group heading is out of view once you're reading the file, and this is
                             the moment the difference actually matters. -->
                        <Border x:Name="ModLoaderConfigNotice" Grid.Row="0" Visibility="Collapsed"
                                Margin="0,0,0,8" Padding="10,8" CornerRadius="6" Background="#22262F"
                                BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="This is the mod loader's config, not the game's."
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock x:Name="ModLoaderConfigNoticeText" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                            <TextBox x:Name="ConfigEditor" AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Consolas" FontSize="12" Background="Transparent"
                                     BorderThickness="0" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     IsEnabled="False"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveConfigButton" Content="Save Changes" Style="{StaticResource AccentButton}"
                                Padding="12,6" FontSize="12" Margin="0,0,8,0" IsEnabled="False" Click="SaveConfig_Click"/>
                        <Button x:Name="RestoreConfigButton" Content="Restore Original" Style="{StaticResource GhostButton}"
                                Padding="10,5" FontSize="12" Margin="0,0,16,0" IsEnabled="False" Click="RestoreConfig_Click"/>
                        <Button Content="Open Folder" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Click="OpenConfigFolder_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
