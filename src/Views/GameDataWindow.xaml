<Window x:Class="DDS2ModManager.Views.GameDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="Saves &amp; Config" Height="640" Width="960" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:BoolToEnabledTextConverter x:Key="BoolToEnabledText"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="DarkTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource DarkTab}"/>
            </TabControl.Resources>

            <!-- ===== Saves ===== -->
            <TabItem Header="Saves">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="SavesPathText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="SavesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" RowHeight="34">
                            <!-- Mode=OneWay on every column: DataGridTextColumn binds TwoWay by
                                 default, and most of these are computed get-only properties. Even
                                 with IsReadOnly on the grid, leaving the default in place is the
                                 same footgun that previously threw "cannot work on the read-only
                                 property" once per row and looked like a hard crash. -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding GroupDisplay, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Contents" Binding="{Binding KindDisplay, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="85"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedDisplay, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Status" Width="80"
                                                    Binding="{Binding IsEnabled, Mode=OneWay, Converter={StaticResource BoolToEnabledText}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Clone..." Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Margin="0,0,8,0" Click="CloneSave_Click"/>
                        <Button Content="Back Up" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Margin="0,0,8,0" Click="BackupSave_Click"
                                ToolTip="Copies this save to a timestamped backup outside the game's save folder."/>
                        <Button Content="Disable" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Margin="0,0,8,0" Click="DisableSave_Click"/>
                        <Button Content="Enable" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Margin="0,0,8,0" Click="EnableSave_Click"/>
                        <Button Content="Delete..." Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Foreground="{StaticResource ErrorBrush}" Margin="0,0,16,0" Click="DeleteSave_Click"/>
                        <Button Content="Open Saves Folder" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Margin="0,0,8,0" Click="OpenSavesFolder_Click"/>
                        <Button Content="Open Backups Folder" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Margin="0,0,8,0" Click="OpenBackupsFolder_Click"/>
                        <Button Content="Refresh" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Click="RefreshSaves_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== Config ===== -->
            <TabItem Header="Config Files">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Text="Editing these changes how the game behaves. The original is backed up automatically the first time you save a file, so you can always put it back. Empty placeholder .ini files are hidden."/>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4">
                        <ListBox x:Name="ConfigList" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="ConfigList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="4">
                        <TextBox x:Name="ConfigEditor" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="12" Background="Transparent"
                                 BorderThickness="0" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 IsEnabled="False"/>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveConfigButton" Content="Save Changes" Style="{StaticResource AccentButton}"
                                Padding="12,6" FontSize="12" Margin="0,0,8,0" IsEnabled="False" Click="SaveConfig_Click"/>
                        <Button x:Name="RestoreConfigButton" Content="Restore Original" Style="{StaticResource GhostButton}"
                                Padding="10,5" FontSize="12" Margin="0,0,16,0" IsEnabled="False" Click="RestoreConfig_Click"/>
                        <Button Content="Open Folder" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                Click="OpenConfigFolder_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
