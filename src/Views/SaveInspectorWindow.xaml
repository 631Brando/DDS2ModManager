<Window x:Class="DDS2ModManager.Views.SaveInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DDS2ModManager.Views"
        Title="Inspect Save" Height="720" Width="1040" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Mode=OneWay throughout: every one of these is a computed get-only property, and WPF
             binds Run.Text and friends TwoWay by default. -->
        <HierarchicalDataTemplate DataType="{x:Type views:InspectorNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Header, Mode=OneWay}" FontSize="12"/>
                <TextBlock Text="{Binding Detail, Mode=OneWay}" FontSize="11" Margin="10,1,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Value, Mode=OneWay}" FontSize="12" Margin="10,0,0,0"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Read-only view of what the game stored in this save. Nothing here writes back to the file. DDS2 saves aren't a standard Unreal format, so a few values can't be typed with certainty - those are shown as a byte count rather than guessed at."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="File" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <ComboBox x:Name="FileCombo" Width="300" SelectionChanged="FileCombo_SelectionChanged"/>
            <CheckBox x:Name="ShowMetadata" Content="Show RamaSave bookkeeping" VerticalAlignment="Center"
                      Margin="16,0,0,0" FontSize="12" Click="Refilter_Click"
                      ToolTip="The fourteen fields RamaSave writes on every actor. Useful for debugging, noise otherwise."/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock x:Name="VerifyText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="FilterBox" Padding="6,4" FontSize="12"
                             TextChanged="FilterBox_TextChanged"/>
                    <!-- Watermark: an empty unlabelled box reads as a rendering glitch rather than
                         as something you can type into. -->
                    <TextBlock x:Name="FilterHint" IsHitTestVisible="False" Margin="9,0,0,0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="actor class or field name, e.g. Hideout or Cash"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Export as Text..." Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="Export_Click"
                    ToolTip="Writes everything shown here to a .txt file."/>
            <Button Content="Expand All Actors" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="ExpandActors_Click"/>
            <Button Content="Collapse All" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="CollapseAll_Click"/>
            <Button Content="Close" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
