<Window x:Class="DDS2ModManager.Views.ModCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Mods" Height="700" Width="900" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="20" FontWeight="Bold" Text="Browse Mods"/>
        <TextBlock Grid.Row="1" x:Name="SubtitleText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <!-- Shown when the list came from the on-disk cache rather than the network, so a stale
             list is never presented as current. -->
        <Border Grid.Row="2" x:Name="OfflineBanner" Visibility="Collapsed" Margin="0,0,0,12"
                Padding="12,9" CornerRadius="6" Background="#2A2418"
                BorderThickness="1" BorderBrush="{StaticResource WarningBrush}">
            <TextBlock x:Name="OfflineText" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="FilterBox" Padding="6,4" FontSize="12" TextChanged="Filter_Changed"/>
                    <TextBlock x:Name="FilterHint" IsHitTestVisible="False" Margin="9,0,0,0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="name, description or tag"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <!-- Empty state doubles as the "catalog not published yet" message, so the page
                         is honest rather than looking broken before the repository exists. -->
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="24"
                               TextWrapping="Wrap" FontSize="12" VerticalAlignment="Top"
                               Foreground="{StaticResource TextMutedBrush}"/>

                    <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" Margin="6,4" CornerRadius="6"
                                        Background="#1B1D27" BorderThickness="1"
                                        BorderBrush="{StaticResource CardBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding VersionDisplay}" FontSize="11" Margin="8,3,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <Border Margin="8,1,0,0" Padding="6,1" CornerRadius="3"
                                                        Background="#242733" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding TagsDisplay}" FontSize="10" Margin="0,5,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                       HorizontalAlignment="Right" Margin="0,0,0,5"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <Button Content="Install" Style="{StaticResource AccentButton}"
                                                    Padding="14,6" FontSize="12" Click="Install_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="View Source" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" FontSize="11" Margin="0,6,0,0"
                                                    Click="ViewSource_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Refresh" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="Refresh_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="Close" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
