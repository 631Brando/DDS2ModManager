<Window x:Class="DDS2ModManager.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="190" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="46"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" x:Name="InputBox" Padding="8"/>

        <!-- Optional caveat shown under the input, e.g. the Steam Cloud warning on Clone. -->
        <Border Grid.Row="2" x:Name="NoteBox" Visibility="Collapsed" Margin="0,10,0,0"
                Padding="10,8" CornerRadius="5" Background="#2A2418"
                BorderThickness="1" BorderBrush="{StaticResource WarningBrush}">
            <TextBlock x:Name="NoteText" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="OK" Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
