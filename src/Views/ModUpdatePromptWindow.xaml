<Window x:Class="DDS2ModManager.Views.ModUpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update mod" Height="520" Width="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

        <!-- Where the download actually comes from. This is the part worth reading before
             agreeing: the URL was declared by the mod itself, so the user should see it. -->
        <Border Grid.Row="2" x:Name="SourceBox" Padding="12,10" CornerRadius="6" Margin="0,0,0,12"
                Background="#1B1D27" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
            <StackPanel>
                <TextBlock x:Name="TrustText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourceText" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12"/>
            </ScrollViewer>
        </Border>

        <CheckBox Grid.Row="4" x:Name="TrustAuthorBox" Margin="0,12,0,0" FontSize="12"
                  ToolTip="Stops the manager asking whether to check this author's mods for updates. It will still ask before installing anything."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="View Source" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="ViewSource_Click"
                    ToolTip="Opens the repository this update would be downloaded from."/>
            <Button Content="Not Now" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Download and Install" Style="{StaticResource AccentButton}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
