<Window x:Class="DDS2ModManager.Views.UE4SSBuildPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a UE4SS build" Height="600" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose a UE4SS build" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12">
            Every experimental build is kept, so you can go back to one that worked. They all call
            themselves "v3.0.1" — the build number and the commit after it are what actually tell
            them apart, and they're what a bug report will ask you for.
        </TextBlock>

        <!-- Console-vs-not is the difference people actually notice, and it is invisible in the
             version, so it is a filter rather than something to spot in the filenames. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="FilterBox" Width="240" Padding="8,6" FontSize="13"
                     Background="#12131A" BorderBrush="{StaticResource CardBorderBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                     TextChanged="FilterBox_TextChanged"
                     ToolTip="Search by build number or commit, e.g. 1093"/>

            <CheckBox x:Name="ConsoleOnlyBox" Content="Console builds only" VerticalAlignment="Center"
                      Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"
                      ToolTip="The console build opens a window showing live UE4SS logs while the game runs."/>

            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="24"
                           TextWrapping="Wrap" FontSize="12" VerticalAlignment="Top"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <ListBox x:Name="BuildList" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         SelectionChanged="BuildList_SelectionChanged"
                         MouseDoubleClick="BuildList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2E2440"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#242733"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Build.Display}" FontSize="13"/>
                                        <!-- The one they have now, so going "back" to it is not a
                                             download they sit through for no reason. -->
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="installed" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#12131A"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Build.AssetName}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Build.SizeDisplay}" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="WarningText" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="11" MaxWidth="360" HorizontalAlignment="Left"
                       Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
                <Button x:Name="InstallButton" Content="Install this build" Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
