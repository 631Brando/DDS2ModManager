<Window x:Class="DDS2ModManager.Views.ResetGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset game to vanilla" Height="470" Width="540" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reset game to vanilla" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16">
            Removes mods from the game itself. Pick what you want gone - everything here is optional.
        </TextBlock>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="TrackedBox" IsChecked="True" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Remove all mods this manager installed" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run x:Name="TrackedCountText" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </TextBlock>
            </CheckBox>

            <CheckBox x:Name="UntrackedBox" IsChecked="True" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Remove mod files it isn't tracking" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="Mod paks placed by hand or left over from another tool. Base game files are never touched."
                         FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </TextBlock>
            </CheckBox>

            <CheckBox x:Name="UE4SSBox" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Also remove UE4SS" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="Deletes dwmapi.dll and the ue4ss folder. Leave unticked to keep UE4SS ready for next time."
                         FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </TextBlock>
            </CheckBox>

            <CheckBox x:Name="ConfigBox" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Also reset the game's config files" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="Wipes graphics, audio and keybind settings back to defaults too, not just mod-related config."
                         FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </TextBlock>
            </CheckBox>
        </StackPanel>

        <Border Grid.Row="3" Background="#241A2E" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,4,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11">
                <Run Text="Your save games are never touched by this." FontWeight="SemiBold"/>
                <Run Text="Use the Saves &amp; Config window if you want to manage those."/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Reset Game" Style="{StaticResource AccentButton}" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>
