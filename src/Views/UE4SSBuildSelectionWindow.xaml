<Window x:Class="DDS2ModManager.Views.UE4SSBuildSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install UE4SS" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Install UE4SS" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14">
            Pick which UE4SS release to install, then whether you want its log console.
        </TextBlock>

        <TextBlock Text="RELEASE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>

        <Border x:Name="ExperimentalCard" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Cursor="Hand"
                MouseLeftButtonUp="ExperimentalOption_Click">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ExperimentalOption" GroupName="Channel" VerticalAlignment="Top" Margin="0,3,10,0"/>
                <StackPanel MaxWidth="420">
                    <TextBlock Text="Experimental (recommended)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                        The build UE4SS publishes as it fixes things. Supports UE 4.7 to 5.8, and is the only release
                        whose Blueprint mod loader works on UE 5.2 and newer.
                    </TextBlock>
                    <TextBlock x:Name="ExperimentalNote" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="StableCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Cursor="Hand"
                MouseLeftButtonUp="StableOption_Click">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="StableOption" GroupName="Channel" VerticalAlignment="Top" Margin="0,3,10,0"/>
                <StackPanel MaxWidth="420">
                    <TextBlock x:Name="StableTitle" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                        The last numbered release, from February 2024. Supports UE 4.12 to 5.3. Uses the older layout:
                        its files go directly in Binaries\Win64.
                    </TextBlock>
                    <TextBlock x:Name="StableNote" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="BUILD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="StandardOption_Click">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="StandardOption" GroupName="Build" IsChecked="True" VerticalAlignment="Top" Margin="0,3,10,0"/>
                <StackPanel MaxWidth="420">
                    <TextBlock Text="Standard (recommended)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="No extra window opens." Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Cursor="Hand" MouseLeftButtonUp="DevOption_Click">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DevOption" GroupName="Build" VerticalAlignment="Top" Margin="0,3,10,0"/>
                <StackPanel MaxWidth="420">
                    <TextBlock Text="Dev (zDEV)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0">
                        Opens an extra console window showing live UE4SS logs while the game runs -
                        handy for troubleshooting mod issues. Mods work exactly the same either way;
                        this only changes whether you see that console.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Continue" Style="{StaticResource AccentButton}" Click="Continue_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
