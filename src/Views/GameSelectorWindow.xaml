<Window x:Class="DDS2ModManager.Views.GameSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="Choose a game" Width="1080" Height="760"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Small label chips, the same shape everywhere so "Full support", an engine version and
             an anti-cheat warning read as one family. -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1F9CA3AF"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7D8492"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ===== One game =====
             The whole card is the button: clicking anywhere on the art or the name opens the game.
             Every visual state lives in ControlTemplate.Triggers targeting named parts - a Style
             trigger on an element whose properties the template sets as attributes is silently
             outranked (see CLAUDE.md), which is how the old tab strip's active state once rendered
             identically to an inactive one. -->
        <DataTemplate x:Key="GameCard">
            <StackPanel Margin="0,0,18,20" Width="156">
                <Button Click="Card_Click" Tag="{Binding}" Cursor="Hand" ToolTip="{Binding CardTooltip}"
                        ToolTipService.InitialShowDelay="700" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Background="Transparent">
                                <Grid x:Name="Art" Width="156" Height="234">

                                    <!-- Fallbacks first, so the box art covers them when it exists:
                                         a colour from the game's name, its icon, or its initials. -->
                                    <Border CornerRadius="10" Background="{Binding PlaceholderBrush}"/>
                                    <TextBlock Text="{Binding Initials}" FontSize="46" FontWeight="Bold"
                                               Foreground="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowInitialsFallback, Converter={StaticResource BoolToVisibility}}"/>
                                    <Image Source="{Binding Icon}" Width="76" Height="76"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ShowIconFallback, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- An ImageBrush as a Border background is what gets rounded
                                         corners on a picture in WPF; an Image inside a rounded Border
                                         keeps square ones. Null until the art has loaded. -->
                                    <Border CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Capsule}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <!-- Not installed / uninstalled: the card says what clicking does. -->
                                    <Border x:Name="StateVeil" CornerRadius="10" Background="#C70E0F15" Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding StateHeadline}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding StateHint}" FontSize="11" Margin="0,4,0,0" TextAlignment="Center"
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Badges over the art. -->
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="● CURRENT" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <Border Background="#E6241D0C" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                            ToolTip="{Binding AntiCheatTooltip}"
                                            Visibility="{Binding HasAntiCheat, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="⚠ ANTI-CHEAT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>

                                    <Border x:Name="Outline" CornerRadius="10" BorderThickness="2" BorderBrush="#26FFFFFF"/>
                                </Grid>

                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Margin="2,9,2,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                <TextBlock Text="{Binding CardSubtitle}" FontSize="11" Margin="2,2,2,0"
                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                    <Setter TargetName="StateVeil" Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <!-- Hover lifts the card and lights its edge; it must look different
                                     from "current", which the old tabs got wrong. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                    <Setter TargetName="Art" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>

                                <!-- Last, so the open game keeps its accent edge even under the pointer. -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Outline" Property="BorderThickness" Value="3"/>
                                </DataTrigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Art" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Outside the card's button on purpose: a button inside a button is a click that
                     belongs to two things at once. -->
                <Button Content="{Binding ForgetLabel}" Style="{StaticResource LinkButton}" FontSize="10.5" Margin="2,3,0,0"
                        HorizontalAlignment="Left" Click="Forget_Click" Tag="{Binding}"
                        ToolTip="Forgets this folder. Nothing in it is touched."
                        Visibility="{Binding CanForget, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="CardWrap">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- The shadow is drawn by a separate border behind the content, not by an Effect on the
         content itself, so text and box art aren't rendered through the effect pipeline. -->
    <Grid Margin="18">
        <Border CornerRadius="14" Background="{StaticResource BgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header (drag to move) ===== -->
                <Grid Grid.Row="0" Margin="28,22,20,14" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Choose a game" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="230" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Padding="28,7,8,7" FontSize="12" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="⌕" FontSize="15" Margin="9,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="SearchHint" Text="Search games" FontSize="12" Margin="29,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#6B7280"/>
                        </Grid>
                        <Button x:Name="RescanButton" Content="↻  Rescan" Style="{StaticResource GhostButton}" Padding="12,7"
                                FontSize="12" Margin="0,0,8,0" Click="Rescan_Click"
                                ToolTip="Look through your Steam, Epic and GOG libraries again."/>
                        <Button Content="+  Add game folder…" Style="{StaticResource GhostButton}" Padding="12,7" FontSize="12"
                                Margin="0,0,12,0" Click="AddFolder_Click"
                                ToolTip="Pick the folder of a game installed somewhere no launcher knows about."/>
                        <Button Content="✕" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                BorderThickness="0" Click="Close_Click" ToolTip="Close  (Esc)"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Games ===== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,4,10,8">
                    <StackPanel>
                        <TextBlock x:Name="FullHeader" Text="FULL SUPPORT" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="FullNote" Style="{StaticResource SectionNote}"
                                   Text="The games this manager was built for: Nexus integration, UE4SS setup, save tools and everything else."/>
                        <ItemsControl x:Name="FullList" ItemTemplate="{StaticResource GameCard}" ItemsPanel="{StaticResource CardWrap}"
                                      Focusable="False"/>

                        <TextBlock x:Name="OtherHeader" Text="OTHER UNREAL ENGINE GAMES" Style="{StaticResource SectionTitle}" Margin="0,8,0,2"/>
                        <TextBlock x:Name="OtherNote" Style="{StaticResource SectionNote}"
                                   Text="Basic support: mods install as paks and conflicts are found by reading every pak. Nexus features, installing UE4SS and save cloning are off, because they need knowledge of each particular game."/>
                        <ItemsControl x:Name="OtherList" ItemTemplate="{StaticResource GameCard}" ItemsPanel="{StaticResource CardWrap}"
                                      Focusable="False"/>
                        <Border x:Name="OtherEmpty" CornerRadius="10" Padding="18,16" Margin="0,0,18,18"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="OtherEmptyText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>

                        <!-- Leftovers: real, and worth knowing about (they can be cleaned up), but not
                             games - so they're out of the way rather than mixed in with the cards. -->
                        <Button x:Name="LeftoverToggle" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                Margin="0,4,0,8" FontSize="12" Click="LeftoverToggle_Click"/>
                        <ItemsControl x:Name="LeftoverList" Visibility="Collapsed" Focusable="False" Margin="0,0,18,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding RootPath}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Open folder" Style="{StaticResource GhostButton}"
                                                    Padding="10,5" FontSize="11" VerticalAlignment="Center"
                                                    Click="OpenLeftoverFolder_Click" Tag="{Binding}"
                                                    ToolTip="See what was left behind. Nothing is deleted by this manager."/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoMatchesText" FontSize="13" Margin="0,30,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Footer ===== -->
                <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,10,28,12">
                    <TextBlock FontSize="11" Foreground="#7D8492">
                        <Run Text="Click a game to open it"/>
                        <Run Text="  ·  " Foreground="#4B5160"/>
                        <Run Text="Enter opens the first match"/>
                        <Run Text="  ·  " Foreground="#4B5160"/>
                        <Run Text="Esc closes"/>
                        <Run Text="  ·  " Foreground="#4B5160"/>
                        <Run Text="Box art comes from your local Steam library cache - nothing is downloaded"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
