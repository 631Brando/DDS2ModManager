<Window x:Class="DDS2ModManager.Views.ModHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod history" Height="620" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Mod history" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="What happened to your mods, and the release notes that came with each update. The manager shows those notes once when you agree to an update and would otherwise discard them, so this is the only place to find out later what a version actually changed."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="0,10,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{StaticResource CardBorderBrush}" CornerRadius="3"
                                                Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding AtLocalDisplay}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>

                                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Text="{Binding Source}" FontSize="10" Margin="0,6,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Visibility="Collapsed"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Nothing here yet. Once you update a mod through the manager, what changed will be recorded here."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Clear history" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="Close" Style="{StaticResource AccentButton}" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
