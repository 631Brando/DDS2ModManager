<Window x:Class="DDS2ModManager.Views.ModAuthorGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make your mod updateable" Height="740" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Make your mod updateable" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                       Text="Add one line to your mod and this manager can tell every player when you publish a new version - and install it for them. It reads the address from the mod itself, so nothing has to be registered anywhere and no API keys are involved."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StepsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Copy the manifest" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="CopyManifest_Click"/>
            <Button Content="Close" Style="{StaticResource AccentButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
