<Window x:Class="DDS2ModManager.Views.TrustedModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="Trusted Mods" Height="760" Width="920" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="20" FontWeight="Bold" Text="Trusted Mods"/>
        <TextBlock Grid.Row="1" x:Name="SubtitleText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <Border Grid.Row="2" x:Name="NoticeBanner" Visibility="Collapsed" Margin="0,0,0,12"
                Padding="12,9" CornerRadius="6" Background="#2A2418"
                BorderThickness="1" BorderBrush="{StaticResource WarningBrush}">
            <TextBlock x:Name="NoticeText" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="FilterBox" Padding="6,4" FontSize="12" TextChanged="Filter_Changed"/>
                    <TextBlock x:Name="FilterHint" IsHitTestVisible="False" Margin="9,0,0,0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="name or description"/>
                </Grid>

                <TextBlock Grid.Column="2" Text="Author" VerticalAlignment="Center" FontSize="12" Margin="14,0,8,0"/>
                <ComboBox Grid.Column="3" x:Name="AuthorBox" Width="190" FontSize="12"
                          SelectionChanged="Author_Changed"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="24"
                               TextWrapping="Wrap" FontSize="12" VerticalAlignment="Top"
                               Foreground="{StaticResource TextMutedBrush}"/>

                    <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="6,4" CornerRadius="6"
                                        Background="#1B1D27" BorderThickness="1"
                                        BorderBrush="{StaticResource CardBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Bound to the row's own Thumbnail, which the window fills
                                             in as each picture arrives. -->
                                        <Border Grid.Column="0" Width="132" Height="74" CornerRadius="4"
                                                ClipToBounds="True" Margin="0,0,12,0"
                                                Background="#12131A" VerticalAlignment="Top"
                                                Visibility="{Binding Post.CardImageUrl, Converter={StaticResource NonEmptyToVisibility}}">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Post.Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxWidth="400"/>
                                                <TextBlock Text="{Binding VersionDisplay}" FontSize="11" Margin="8,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <!-- The author matters more here than on a single-author
                                                 page: the whole list is several people's work, and
                                                 "who made this" is the reason a row is present. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="by " FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <Button Content="{Binding Post.Uploader}" Click="OpenProfile_Click"
                                                        Tag="{Binding}" Cursor="Hand"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                        ToolTip="{Binding AuthorNote}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Post.Summary}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,5,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding Post.Downloads, StringFormat='{}{0:N0} downloads'}"/>
                                                <TextBlock FontSize="10" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding Post.Endorsements, StringFormat='{}{0:N0} endorsements'}"/>
                                                <TextBlock FontSize="10" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding UpdatedDisplay}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Border Padding="7,2" CornerRadius="3" Margin="0,0,0,6"
                                                    Background="{StaticResource CardBorderBrush}"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Installed" FontSize="10"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>

                                            <!-- The manager's own page. Without this it reads as a
                                                 mod to install, which it isn't. -->
                                            <Border Padding="7,2" CornerRadius="3" Margin="0,0,0,6"
                                                    Background="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding IsThisApp, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="This is the mod manager you're running right now, not a mod. Its page is here so you can read the description or endorse it - updates come through the app itself.">
                                                <TextBlock Text="This app" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>

                                            <Button Content="Open on Nexus" Style="{StaticResource AccentButton}"
                                                    Padding="14,6" FontSize="12" Click="OpenOnNexus_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Refresh" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="Refresh_Click"
                    ToolTip="Re-fetches the author list and the mods from Nexus."/>
            <Button Content="Browse all DDS2 mods" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="OpenGame_Click"
                    ToolTip="Opens Nexus, where you can see everything published for the game - not only these authors."/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="Close" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
