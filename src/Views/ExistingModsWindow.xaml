<Window x:Class="DDS2ModManager.Views.ExistingModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DDS2ModManager.Converters"
        Title="Existing mods found" Height="560" Width="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:ModTypeToBrushConverter x:Key="ModTypeToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Existing mods found" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14">
            These mods are already in your game folders but aren't being tracked by this manager, so they can't be
            enabled, disabled, uninstalled, or included in conflict checks. Importing them leaves the files exactly
            where they are - it just starts tracking them.
        </TextBlock>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ModList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#20222E" CornerRadius="6" Padding="10" Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                            <Border Background="{Binding DetectedType, Converter={StaticResource ModTypeToBrush}}"
                                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#12131A"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding IssuesDisplay}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding CurrentFolder}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Visibility is set in code-behind: only shown when at least one found mod is actually
             misplaced, so the option doesn't imply a problem that isn't there. -->
        <CheckBox Grid.Row="3" x:Name="FixMisplacedBox" IsChecked="True" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Also move misplaced mods into the correct folder"/>
                <LineBreak/>
                <Run Text="Recommended - a mod in the wrong folder isn't being loaded by the game at all." FontSize="10"
                     Foreground="{StaticResource TextMutedBrush}"/>
            </TextBlock>
        </CheckBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Select All" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,8,0" Click="SelectAll_Click"/>
            <Button Content="Select None" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,16,0" Click="SelectNone_Click"/>
            <Button Content="Not Now" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Import Selected" Style="{StaticResource AccentButton}" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
