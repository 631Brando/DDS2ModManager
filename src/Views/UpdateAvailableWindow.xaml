<Window x:Class="DDS2ModManager.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Height="540" Width="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="2" Text="What's new" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="View on GitHub" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                    Margin="0,0,16,0" Click="ViewOnGitHub_Click"/>
            <Button Content="Later" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Later_Click"/>
            <Button Content="Update Now" Style="{StaticResource AccentButton}" Click="Update_Click"/>
        </StackPanel>
    </Grid>
</Window>
