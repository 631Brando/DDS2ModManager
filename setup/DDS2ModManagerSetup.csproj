<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DDS2ModManagerSetup</RootNamespace>
    <AssemblyName>DDS2ModManagerSetup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Product>DDS2 Mod Manager Setup</Product>
    <Version>1.0.6</Version>

    <!-- Same single-file treatment as the main app - see DDS2ModManager.csproj for why. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Same as the main app: publish beside the build output. See DDS2ModManager.csproj. -->
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)'=='Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Deliberately linked, not a ProjectReference to DDS2ModManager.csproj - referencing the main
      project would drag in CUE4Parse and the rest of its dependency graph just to reuse a few
      small, dependency-free helper files.
    -->
    <Compile Include="..\src\Services\LoggingService.cs" Link="Shared\LoggingService.cs" />
    <Compile Include="..\src\Services\GitHubReleaseService.cs" Link="Shared\GitHubReleaseService.cs" />
    <Compile Include="..\src\Services\ShortcutCreator.cs" Link="Shared\ShortcutCreator.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- These linked files rely on the same set of implicit usings the main project's
         GlobalUsings.cs gives them (its ImplicitUsings set doesn't cover all of these). -->
    <Using Include="System.IO" />
    <Using Include="System.Collections.ObjectModel" />
    <Using Include="System.Text.Json" />
  </ItemGroup>

</Project>
