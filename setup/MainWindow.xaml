<Window x:Class="DDS2ModManagerSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDS Mod Manager Setup" Height="440" Width="480"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DDS Mod Manager" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText" Text="Downloads and installs the latest release from GitHub."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Install location" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPathBox" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}"
                        Padding="10,5" FontSize="12" Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <CheckBox x:Name="DesktopShortcutBox" Content="Create a Desktop shortcut" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="StartMenuShortcutBox" Content="Create a Start Menu shortcut" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="LaunchAfterInstallBox" Content="Launch DDS Mod Manager after installing" IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}" Click="Install_Click"/>
        </StackPanel>
    </Grid>
</Window>
